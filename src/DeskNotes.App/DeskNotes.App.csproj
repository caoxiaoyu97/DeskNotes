<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>DeskNotes</AssemblyName>
    <SatelliteResourceLanguages>zh-Hans;en</SatelliteResourceLanguages>
    <Version>0.4.6</Version>
    <ApplicationIcon>..\..\assets\DeskNotes.ico</ApplicationIcon>
    <!-- WPF owns DPI awareness; WinForms is used only for tray and folder picker. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>
  <ItemGroup><ProjectReference Include="../DeskNotes.Core/DeskNotes.Core.csproj" /></ItemGroup>
  <ItemGroup><Resource Include="..\..\assets\DeskNotes.ico" Link="assets\DeskNotes.ico" /></ItemGroup>
</Project>
